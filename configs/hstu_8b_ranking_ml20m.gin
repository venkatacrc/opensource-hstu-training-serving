# HSTU-8B ranking model on MovieLens-20M (public dataset).
#
# Sizing math (dense backbone only; see docs/ARCHITECTURE.md for derivation):
#   params/layer ~= 5 * hidden_size^2   (when num_attention_heads * kv_channels == hidden_size)
#   hidden_size=8192, num_layers=24 -> 5 * 24 * 8192^2 ~= 8.05e9 dense params
# Embedding tables + prediction head add only a few hundred MB given ml-20m's
# small item vocabulary (~27K items), so total parameter count stays ~8.05-8.1B,
# squarely inside the requested 7-10B band.
#
# This is a STARTING configuration. `scripts/04_size_model.sh` runs the upstream
# memory estimator + a short smoke run against this file and emits
# `hstu_8b_ranking_ml20m.tuned.gin` with the empirically-validated
# train_batch_size / tensor_model_parallel_size for this exact box. Training
# and inference scripts load base + tuned file together so overrides win:
#   --gin-config-file hstu_8b_ranking_ml20m.gin \
#   --gin-config-file hstu_8b_ranking_ml20m.tuned.gin

# --- Trainer -----------------------------------------------------------------
TrainerArgs.train_batch_size = 16          # tuned by 04_size_model.sh
TrainerArgs.eval_batch_size = 16
TrainerArgs.log_interval = 20
TrainerArgs.eval_interval = 500
TrainerArgs.ckpt_save_interval = 500
TrainerArgs.seed = 1234
TrainerArgs.max_train_iters = 200000       # effectively "train until wall-clock budget", see 05_train.sh
TrainerArgs.profile = True
TrainerArgs.profile_step_start = 60
TrainerArgs.profile_step_end = 90
TrainerArgs.pipeline_type = "prefetch"
TrainerArgs.enable_balanced_shuffler = True

# --- Dataset: MovieLens-20M (ml-20m has 1 contextual feature per the ---------
# --- upstream training README) ------------------------------------------------
DatasetArgs.dataset_name = 'ml-20m'
# seqlen fed to HSTU attention = contextual + (history + candidates) * 2
# 1 + (2048 + 64) * 2 = 4225 tokens/user -> deliberately in HSTU's long-sequence
# regime where the paper reports its largest speedup vs FlashAttention-2.
DatasetArgs.max_history_seqlen = 2048
DatasetArgs.max_num_candidates = 64
DatasetArgs.shuffle = True

# --- Network: HSTU-8B dense backbone -----------------------------------------
NetworkArgs.dtype_str = "bfloat16"
NetworkArgs.num_layers = 24
NetworkArgs.num_attention_heads = 64
NetworkArgs.hidden_size = 8192
NetworkArgs.kv_channels = 128              # 64 * 128 = 8192 = hidden_size
NetworkArgs.item_embedding_dim = 512
NetworkArgs.contextual_embedding_dim = 512
NetworkArgs.kernel_backend = 'cutlass'
NetworkArgs.target_group_size = 1
# Recompute trades a small perf hit for large activation-memory savings at
# this scale; kept on for the initial smoke test, revisited once memory
# headroom is measured.
NetworkArgs.recompute_input_layernorm = True
NetworkArgs.recompute_input_silu = False

# --- Ranking head --------------------------------------------------------------
# ml-20m ratings 1..5 in 0.5 steps -> treated as a single regression/AUC task.
RankingArgs.prediction_head_arch = [1024, 10]
RankingArgs.prediction_head_bias = True
RankingArgs.num_tasks = 1
RankingArgs.eval_metrics = ("AUC",)

# --- Optimizer -----------------------------------------------------------------
OptimizerArgs.optimizer_str = 'adam'
OptimizerArgs.learning_rate = 1e-3
OptimizerArgs.adam_beta1 = 0.9
OptimizerArgs.adam_beta2 = 0.98

# --- Parallelism ----------------------------------------------------------------
# TP=8 shards the 8.05B dense backbone across the whole node (~1B params/GPU)
# so bf16 weights + grads + fp32 Adam state stay well under 183GB/GPU. DynamicEmb
# / TorchRec shard the (tiny, for ml-20m) embedding tables independently.
TensorModelParallelArgs.tensor_model_parallel_size = 8
