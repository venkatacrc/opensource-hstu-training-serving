#!/usr/bin/env bash
# Central configuration for the HSTU 7-10B train+serve pipeline.
# Sourced by every script in scripts/. Override any value by exporting it in
# your shell before running run_all.sh, e.g.:
#   TOTAL_TRAIN_HOURS=6 ./scripts/run_all.sh
#
# All paths below are relative to the repo root unless already absolute.

# --- Repo / workdir layout -------------------------------------------------
: "${WORK_DIR:=$REPO_ROOT/workdir}"                     # heavy artifacts, gitignored
: "${RECSYS_DIR:=$WORK_DIR/recsys-examples}"             # NVIDIA/recsys-examples checkout
: "${DATA_DIR:=$WORK_DIR/data}"                          # raw + preprocessed datasets
: "${CKPT_DIR:=$WORK_DIR/checkpoints}"                   # training checkpoints
: "${EXPORT_DIR:=$WORK_DIR/export}"                      # AOTI / torch.export artifacts
: "${TRITON_REPO_DIR:=$WORK_DIR/triton_model_repo}"      # Triton model repositories

# --- Upstream reference implementation -------------------------------------
: "${RECSYS_REMOTE:=https://github.com/NVIDIA/recsys-examples.git}"
: "${RECSYS_TAG:=v26.06.01}"                             # pin for reproducibility
: "${BASE_IMAGE:=nvcr.io/nvidia/pytorch:26.05-py3}"
: "${IMAGE_NAME:=recsys-examples:hstu-bench}"
: "${CONTAINER_NAME:=hstu-bench}"

# --- GPU / cluster shape -----------------------------------------------------
: "${NUM_GPUS:=8}"
: "${MASTER_PORT:=6000}"

# --- Model target ------------------------------------------------------------
# 8b is the primary target requested (7-10B band); 10b is an optional stretch
# config included but not on the default critical path.
: "${MODEL_SIZE:=8b}"                                    # 8b | 10b

# PRIMARY_DATASET: the main, long training run (TP=8 across the node) that is
# the headline "trained an 8B HSTU model" deliverable.
: "${PRIMARY_DATASET:=ml-20m}"                            # ml-20m | kuairand-1k

# SECONDARY_DATASET: trained TP=1 (see configs/hstu_8b_ranking_kuairand1k.gin
# scope note) specifically to produce the checkpoint used by
# scripts/06_export_checkpoint.sh and scripts/07_serving_bench.sh -- the
# upstream inference/Triton/AOTI examples hard-code dataset assumptions to
# "kuairand-1k" and are only demonstrated with a TP=1 checkpoint.
: "${SECONDARY_DATASET:=kuairand-1k}"

# --- Time budget (hours), used to time-box the long-running training phases -
: "${TOTAL_BUDGET_HOURS:=24}"
: "${TRAIN_BUDGET_HOURS:=12}"                             # wall-clock cap for the PRIMARY_DATASET run
: "${SECONDARY_TRAIN_BUDGET_HOURS:=2}"                    # wall-clock cap for the SECONDARY_DATASET (serving) run

# --- Serving benchmark sweep --------------------------------------------------
: "${BENCH_BATCH_SIZES:=1,2,4,8,16,32,64}"
: "${BENCH_WARMUP_REQUESTS:=20}"
: "${BENCH_MEASURED_REQUESTS:=200}"

export WORK_DIR RECSYS_DIR DATA_DIR CKPT_DIR EXPORT_DIR TRITON_REPO_DIR
export RECSYS_REMOTE RECSYS_TAG BASE_IMAGE IMAGE_NAME CONTAINER_NAME
export NUM_GPUS MASTER_PORT
export MODEL_SIZE PRIMARY_DATASET SECONDARY_DATASET
export TOTAL_BUDGET_HOURS TRAIN_BUDGET_HOURS SECONDARY_TRAIN_BUDGET_HOURS
export BENCH_BATCH_SIZES BENCH_WARMUP_REQUESTS BENCH_MEASURED_REQUESTS
