# HSTU-10B ranking model on MovieLens-20M -- OPTIONAL STRETCH CONFIG.
#
# Not on the default critical path (scripts/run_all.sh trains the 8B config by
# default). Use this only if the 8B run finishes with spare time in the 24h
# budget: `MODEL_SIZE=10b ./scripts/05_train.sh`.
#
# Same math as hstu_8b_ranking_ml20m.gin, more layers:
#   5 * 30 * 8192^2 ~= 10.07e9 dense params.
# Everything else (dataset, sequence length, optimizer, TP degree) is identical
# to the 8B config so results are comparable apples-to-apples.

TrainerArgs.train_batch_size = 16          # re-validate with 04_size_model.sh MODEL_SIZE=10b
TrainerArgs.eval_batch_size = 16
TrainerArgs.log_interval = 20
TrainerArgs.eval_interval = 500
TrainerArgs.ckpt_save_interval = 500
TrainerArgs.seed = 1234
TrainerArgs.max_train_iters = 200000
TrainerArgs.profile = True
TrainerArgs.profile_step_start = 60
TrainerArgs.profile_step_end = 90
TrainerArgs.pipeline_type = "prefetch"
TrainerArgs.enable_balanced_shuffler = True

DatasetArgs.dataset_name = 'ml-20m'
DatasetArgs.max_history_seqlen = 2048
DatasetArgs.max_num_candidates = 64
DatasetArgs.shuffle = True

NetworkArgs.dtype_str = "bfloat16"
NetworkArgs.num_layers = 30
NetworkArgs.num_attention_heads = 64
NetworkArgs.hidden_size = 8192
NetworkArgs.kv_channels = 128
NetworkArgs.item_embedding_dim = 512
NetworkArgs.contextual_embedding_dim = 512
NetworkArgs.kernel_backend = 'cutlass'
NetworkArgs.target_group_size = 1
NetworkArgs.recompute_input_layernorm = True
NetworkArgs.recompute_input_silu = False

RankingArgs.prediction_head_arch = [1024, 10]
RankingArgs.prediction_head_bias = True
RankingArgs.num_tasks = 1
RankingArgs.eval_metrics = ("AUC",)

OptimizerArgs.optimizer_str = 'adam'
OptimizerArgs.learning_rate = 1e-3
OptimizerArgs.adam_beta1 = 0.9
OptimizerArgs.adam_beta2 = 0.98

TensorModelParallelArgs.tensor_model_parallel_size = 8
