# HSTU-8B ranking model on KuaiRand-1K (public dataset) -- SECONDARY dataset run.
#
# Same dense backbone as hstu_8b_ranking_ml20m.gin (~8.05B params) but a very
# different sequence-length / multi-task profile (KuaiRand-1K: 1000 users,
# ~4.4M items, 8 ranking tasks, much longer per-user histories).
#
# IMPORTANT SCOPE NOTE: this checkpoint is the one used for the Phase 6/7
# serving benchmark (scripts/06_export_checkpoint.sh, scripts/07_serving_bench.sh),
# NOT the primary ml-20m training run. The upstream inference examples
# (inference/inference_gr_ranking.py, the Triton Python backend, and the AOTI
# export path) hard-code their dataset/embedding assumptions to "kuairand-1k"
# and are demonstrated end-to-end only with a **tensor_model_parallel_size=1**
# checkpoint. Using TP=1 here sidesteps checkpoint-resharding risk entirely and
# matches the officially-supported path, at the cost of a separate, shorter
# training run (see SECONDARY_TRAIN_BUDGET_HOURS in config.env) distinct from
# the long TP=8 ml-20m run. Both runs use the identical dense architecture, so
# training MFU/TFLOPS numbers are still comparable between the two datasets.

TrainerArgs.train_batch_size = 8           # tuned by 04_size_model.sh (longer sequences -> smaller batch)
TrainerArgs.eval_batch_size = 8
TrainerArgs.log_interval = 20
TrainerArgs.eval_interval = 500
TrainerArgs.ckpt_save_interval = 500
TrainerArgs.seed = 1234
TrainerArgs.max_train_iters = 200000
TrainerArgs.profile = True
TrainerArgs.profile_step_start = 60
TrainerArgs.profile_step_end = 90
TrainerArgs.pipeline_type = "prefetch"
TrainerArgs.enable_balanced_shuffler = True

DatasetArgs.dataset_name = 'kuairand-1k'
DatasetArgs.max_history_seqlen = 2048
DatasetArgs.max_num_candidates = 100
DatasetArgs.shuffle = False
NetworkArgs.disable_contextual_mask = True

NetworkArgs.dtype_str = "bfloat16"
NetworkArgs.num_layers = 24
NetworkArgs.num_attention_heads = 64
NetworkArgs.hidden_size = 8192
NetworkArgs.kv_channels = 128
NetworkArgs.item_embedding_dim = 512
NetworkArgs.contextual_embedding_dim = 512
NetworkArgs.kernel_backend = 'triton'
NetworkArgs.target_group_size = 1
NetworkArgs.recompute_input_layernorm = True
NetworkArgs.recompute_input_silu = True
NetworkArgs.sequence_parallel = True

RankingArgs.prediction_head_arch = [1024, 8]
RankingArgs.prediction_head_bias = True
RankingArgs.num_tasks = 8

OptimizerArgs.optimizer_str = 'adam'
OptimizerArgs.learning_rate = 1e-3

# TP=1 (default) -- see scope note above. scripts/04_size_model.sh /
# 05_train.sh run this one with DP=8 (8 independent replicas) instead of TP=8.
TensorModelParallelArgs.tensor_model_parallel_size = 4

NetworkArgs.embedding_backend = 'NVEmb'
DatasetArgs.dataset_path = '/workspace/data'
